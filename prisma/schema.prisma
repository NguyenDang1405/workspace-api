generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, vector]
}

enum Role {
  ADMIN
  PM
  LEADER
  MEMBER
}

enum Department {
  FRONTEND
  BACKEND
  DEVOPS
  QA
  FULLSTACK
}

enum Level {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
}

enum Complexity {
  EASY
  MEDIUM
  HARD
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AccountType {
  INDIVIDUAL
  ENTERPRISE
}

enum SlotType {
  FREE_TIME
  BUSY_CLASS
  BUSY_EXAM
  OTHER
}

enum TaskStatus {
  SCHEDULED
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique @db.Citext
  passwordHash         String               @map("hashed_password")
  fullName             String               @map("full_name") @db.VarChar(100)
  role                 Role                 @default(MEMBER)
  avatarUrl            String?              @map("avatar_url")
  isActive             Boolean              @default(true) @map("is_active")
  authVersion          Int                  @default(1) @map("auth_version")
  accountType          AccountType          @default(INDIVIDUAL) @map("account_type")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tokens               UserToken[]
  talentProfile        UserTalentProfile?
  ledTeams             Team[]               @relation("TeamLeader")
  teamMemberships      TeamMember[]
  ownedProjects        Project[]            @relation("ProjectOwner")
  assignedTasks        Task[]               @relation("TaskAssignee")
  statusChanges        TaskStatusHistory[]  @relation("StatusChanger")
  skillRatings         UserSkillRating[]
  auditSubject         TalentAuditLog[]     @relation("AuditSubject")
  auditActor           TalentAuditLog[]     @relation("AuditActor")
  dispatchAssignments  DispatchHistory[]    @relation("ChosenUser")
  skillRatingLogs      UserSkillRatingLog[]
  availabilitySlots    UserAvailabilitySlot[]
  workspaceMemberships WorkspaceMember[]

  @@map("users")
}

model UserToken {
  id                String      @id @default(uuid()) @db.Uuid
  tokenFamilyId     String      @default(uuid()) @map("token_family_id") @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  refreshTokenHash  String      @unique @map("refresh_token_hash")
  deviceInfo        String?     @map("device_info") @db.VarChar(255)
  ipAddress         String?     @map("ip_address") @db.Inet
  revokedAt         DateTime?   @map("revoked_at") @db.Timestamptz
  revokeReason      String?     @map("revoke_reason") @db.VarChar(50)
  replacedByTokenId String?     @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken   UserToken?  @relation("TokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesTokens    UserToken[] @relation("TokenReplacement")

  @@index([userId, expiresAt(sort: Desc)], map: "idx_user_tokens_active")
  @@map("user_tokens")
}

model UserTalentProfile {
  userId               String                       @id @map("user_id") @db.Uuid
  department           Department                   @default(FULLSTACK)
  level                Level                        @default(JUNIOR)
  skills               String[]                     @default([])
  bioSummary           String?                      @map("bio_summary")
  skillEmbedding       Unsupported("vector(1536)")? @map("skill_embedding")
  profileRevision      BigInt                       @default(1) @map("profile_revision")
  embeddingRevision    BigInt                       @default(0) @map("embedding_revision")
  lastEmbeddedAt       DateTime?                    @map("last_embedded_at") @db.Timestamptz
  isEmbeddingStale     Boolean                      @default(true) @map("is_embedding_stale")
  searchVector         Unsupported("tsvector")?     @map("search_vector")
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department, level, userId], map: "idx_talent_dispatch_filter")
  @@map("user_talent_profiles")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?      @db.Text
  leaderId    String?      @map("leader_id") @db.Uuid
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  leader      User?        @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  memberships TeamMember[]
  projects    Project[]

  @@map("teams")
}

model TeamMember {
  id       String    @id @default(uuid()) @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt   DateTime? @map("left_at") @db.Timestamptz

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], map: "uq_team_members_active_membership")
  @@index([userId, teamId], map: "idx_team_members_active_user")
  @@map("team_members")
}

model Project {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String               @db.VarChar(200)
  description           String               @db.Text
  techStack             String[]             @default([]) @map("tech_stack")
  complexity            Complexity           @default(MEDIUM)
  teamId                String?              @map("team_id") @db.Uuid
  ownerId               String               @map("owner_id") @db.Uuid
  sourceDocumentUrl     String?              @map("source_document_url")
  documentParsedSummary Json?                @map("document_parsed_summary")
  startDate             DateTime             @default(now()) @map("start_date") @db.Date
  targetEndDate         DateTime             @map("target_end_date") @db.Date
  status                ProjectStatus        @default(ACTIVE)
  isPersonalMode        Boolean              @default(false) @map("is_personal_mode")
  workspaceId           String?              @map("workspace_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team                  Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  workspace             Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner                 User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks                 Task[]
  documents             ProjectDocument[]
  reschedulingEvents    ReschedulingEvent[]
  standupReports        DailyStandupReport[]

  @@index([teamId, status], map: "idx_projects_team_status")
  @@map("projects")
}

model ProjectDocument {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  fileName         String   @map("file_name") @db.VarChar(255)
  fileUrl          String   @map("file_url") @db.Text
  rawContent       String?  @map("raw_content") @db.Text
  extractedStories Json?    @map("extracted_stories")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)], map: "idx_project_documents_project")
  @@map("project_documents")
}

model Task {
  id                   String               @id @default(uuid()) @db.Uuid
  projectId            String               @map("project_id") @db.Uuid
  parentTaskId         String?              @map("parent_task_id") @db.Uuid
  title                String               @db.VarChar(255)
  description          String               @db.Text
  priority             TaskPriority         @default(MEDIUM)
  targetDepartment     Department           @default(FULLSTACK) @map("target_department")
  requiredLevel        Level                @default(JUNIOR) @map("required_level")
  estimatedHours       Decimal              @default(4.0) @map("estimated_hours") @db.Decimal(4, 1)
  actualHours          Decimal?             @map("actual_hours") @db.Decimal(5, 2)
  status               TaskStatus           @default(SCHEDULED)
  assignedTo           String?              @map("assigned_to") @db.Uuid
  checklist            Json                 @default("[]")
  
  // Véc-tơ ngữ nghĩa Task (MOD-03, MOD-04 HNSW)
  taskEmbedding        Unsupported("vector(1536)")? @map("task_embedding")
  
  // Tham số Đường găng (CPM) (MOD-02)
  earlyStart           Decimal              @default(0.0) @map("early_start") @db.Decimal(5, 1)
  earlyFinish          Decimal              @default(0.0) @map("early_finish") @db.Decimal(5, 1)
  lateStart            Decimal              @default(0.0) @map("late_start") @db.Decimal(5, 1)
  lateFinish           Decimal              @default(0.0) @map("late_finish") @db.Decimal(5, 1)
  slackTime            Decimal              @default(0.0) @map("slack_time") @db.Decimal(5, 1)
  isCriticalPath       Boolean              @default(false) @map("is_critical_path")
  
  // Tham số Quan trắc luồng việc & Little's Law (MOD-05 & MOD-08)
  startedAt            DateTime?            @map("started_at") @db.Timestamptz
  inReviewAt           DateTime?            @map("in_review_at") @db.Timestamptz
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz
  startDate            DateTime?            @map("start_date") @db.Date
  dueDate              DateTime?            @map("due_date") @db.Date
  isBlocked            Boolean              @default(false) @map("is_blocked")
  blockReason          String?              @map("block_reason") @db.VarChar(255)
  
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask           Task?                @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks             Task[]               @relation("TaskHierarchy")
  assignee             User?                @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  dependencies         TaskDependency[]     @relation("SuccessorTasks")
  dependents           TaskDependency[]     @relation("PredecessorTasks")
  dispatchHistories    DispatchHistory[]
  skillRatingLogs      UserSkillRatingLog[]
  gitPRs               GitPullRequest[]
  statusHistories      TaskStatusHistory[]
  triggeredReschedules ReschedulingEvent[]

  @@index([projectId, status], map: "idx_tasks_dispatch")
  @@index([assignedTo, status], map: "idx_tasks_kanban")
  @@map("tasks")
}

model TaskDependency {
  predecessorId  String   @map("predecessor_id") @db.Uuid
  successorId    String   @map("successor_id") @db.Uuid
  dependencyType String   @default("FS") @map("dependency_type") @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  predecessor    Task     @relation("PredecessorTasks", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor      Task     @relation("SuccessorTasks", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId], map: "idx_task_deps_succ")
  @@index([predecessorId], map: "idx_task_deps_pred")
  @@map("task_dependencies")
}

model DispatchHistory {
  id                    String   @id @default(uuid()) @db.Uuid
  taskId                String   @map("task_id") @db.Uuid
  recommendedCandidates Json     @map("recommended_candidates")
  chosenUserId          String   @map("chosen_user_id") @db.Uuid
  isHumanOverride       Boolean  @default(false) @map("is_human_override")
  overrideReason        String?  @map("override_reason") @db.Text
  dispatchedAt          DateTime @default(now()) @map("dispatched_at") @db.Timestamptz

  task                  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chosenUser            User     @relation("ChosenUser", fields: [chosenUserId], references: [id], onDelete: Cascade)

  @@index([taskId, dispatchedAt(sort: Desc)], map: "idx_dispatch_history_task")
  @@index([chosenUserId, dispatchedAt(sort: Desc)], map: "idx_dispatch_history_user")
  @@map("dispatch_history")
}

model GitPullRequest {
  id                     String    @id @default(uuid()) @db.Uuid
  taskId                 String    @map("task_id") @db.Uuid
  prNumber               Int       @map("pr_number")
  prUrl                  String    @map("pr_url")
  branchName             String    @map("branch_name") @db.VarChar(100)
  authorGithubUsername   String    @map("author_github_username") @db.VarChar(100)
  diffSummary            String?   @map("diff_summary") @db.Text
  aiVerificationFeedback String?   @map("ai_verification_feedback") @db.Text
  isVerifiedByAi         Boolean   @default(false) @map("is_verified_by_ai")
  status                 String    @default("OPEN") @db.VarChar(20)
  mergedAt               DateTime? @map("merged_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  task                   Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status], map: "idx_git_pr_task")
  @@map("git_pull_requests")
}

model ReschedulingEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  triggerTaskId        String?  @map("trigger_task_id") @db.Uuid
  reason               String   @db.VarChar(100)
  originalMakespanDays Decimal  @map("original_makespan_days") @db.Decimal(4, 1)
  newMakespanDays      Decimal  @map("new_makespan_days") @db.Decimal(4, 1)
  mitigationStrategy   Json?    @map("mitigation_strategy")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggerTask          Task?    @relation(fields: [triggerTaskId], references: [id], onDelete: SetNull)

  @@map("rescheduling_events")
}

model DailyStandupReport {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  reportDate         DateTime @default(now()) @map("report_date") @db.Date
  summaryYesterday   String   @map("summary_yesterday") @db.Text
  planToday          String   @map("plan_today") @db.Text
  identifiedBlockers String   @map("identified_blockers") @db.Text
  flowMetrics        Json?    @map("flow_metrics")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, reportDate], map: "uq_project_standup_date")
  @@map("daily_standup_reports")
}

model UserSkillRating {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  skillName      String   @map("skill_name") @db.VarChar(50)
  ratingScore    Decimal  @default(1200.00) @map("rating_score") @db.Decimal(6, 2)
  tasksCompleted Int      @default(0) @map("tasks_completed")
  tasksRejected  Int      @default(0) @map("tasks_rejected")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName], map: "uq_user_skill")
  @@index([userId, skillName], map: "idx_user_skills")
  @@map("user_skill_ratings")
}

model UserSkillRatingLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  skillName String   @map("skill_name") @db.VarChar(50)
  taskId    String?  @map("task_id") @db.Uuid
  oldRating Decimal  @map("old_rating") @db.Decimal(6, 2)
  newRating Decimal  @map("new_rating") @db.Decimal(6, 2)
  delta     Decimal  @map("delta") @db.Decimal(6, 2)
  eventType String   @map("event_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, skillName, createdAt(sort: Desc)], map: "idx_user_skill_logs")
  @@map("user_skill_rating_logs")
}

model TaskStatusHistory {
  id                            String   @id @default(uuid()) @db.Uuid
  taskId                        String   @map("task_id") @db.Uuid
  changedBy                     String?  @map("changed_by") @db.Uuid
  fromStatus                    String   @map("from_status") @db.VarChar(20)
  toStatus                      String   @map("to_status") @db.VarChar(20)
  durationInPreviousStatusHours Decimal? @map("duration_in_previous_status_hours") @db.Decimal(7, 2)
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz

  task                          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changer                       User?    @relation("StatusChanger", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt(sort: Desc)], map: "idx_task_history_lookup")
  @@map("task_status_history")
}

model TalentAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  subjectUserId String?  @map("subject_user_id") @db.Uuid
  changedBy     String?  @map("changed_by") @db.Uuid
  actionType    String   @map("action_type") @db.VarChar(50)
  oldData       Json?    @map("old_data")
  newData       Json?    @map("new_data")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  subjectUser   User?    @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  actor         User?    @relation("AuditActor", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt(sort: Desc)], map: "idx_talent_audit_lookup")
  @@map("talent_audit_logs")
}

model UserAvailabilitySlot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") // 0 (Sunday) -> 6 (Saturday)
  startTime String   @map("start_time") @db.VarChar(10) // Format "HH:mm" (e.g., "19:00")
  endTime   String   @map("end_time") @db.VarChar(10)   // Format "HH:mm" (e.g., "22:30")
  slotType  SlotType @default(FREE_TIME)  @map("slot_type")
  createdAt DateTime @default(now())      @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek], map: "idx_user_availability_lookup")
  @@map("user_availability_slots")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(100)
  slug      String            @unique @db.VarChar(100)
  ownerId   String            @map("owner_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members   WorkspaceMember[]
  projects  Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("OWNER") @db.VarChar(20)
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "uq_workspace_members")
  @@map("workspace_members")
}
